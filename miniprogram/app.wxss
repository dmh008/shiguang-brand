page {
  --color-bg: #f5f0e8;
  --color-surface: #fffaf3;
  --color-ink: #1c1917;
  --color-muted: #78716c;
  --color-accent: #b45309;
  --color-accent-soft: #fed7aa;
  --color-line: #e7e0d5;
  --color-ok: #166534;
  background: var(--color-bg);
  color: var(--color-ink);
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100%;
}

.page {
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 28rpx 8rpx 36rpx;
}

.brand {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--color-ink);
}

.lede {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 28rpx 0 16rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--color-muted);
}

.pill {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-size: 22rpx;
}

.btn {
  margin-top: 16rpx;
  background: var(--color-ink);
  color: #fffaf3;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 28rpx;
  text-align: center;
}

.btn-secondary {
  background: transparent;
  color: var(--color-ink);
  border: 2rpx solid var(--color-line);
}

.btn-accent {
  background: var(--color-accent);
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.list-item:last-child {
  border-bottom: none;
}

.stat-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.stat {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.stat-inner {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  padding: 24rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.empty {
  padding: 48rpx 16rpx;
  text-align: center;
  color: var(--color-muted);
}

.banner {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 20rpx;
}

.banner.live {
  color: var(--color-ok);
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.field-input {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.picker-value {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
