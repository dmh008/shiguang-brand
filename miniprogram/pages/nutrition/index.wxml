<view class="page">
  <view class="hero">
    <view class="brand" style="font-size:40rpx;">今日营养</view>
    <view class="lede">由饮食记录汇总，估算值仅供日常参考。</view>
  </view>

  <view class="banner {{source === 'api' ? 'live' : ''}}">{{modeText}}</view>

  <view class="stat-grid">
    <view class="stat" wx:for="{{stats}}" wx:key="key">
      <view class="stat-inner">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="section-title">餐次构成</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!byMeal.length}}" class="empty">暂无数据</view>
  <block wx:else>
    <view class="list-item" wx:for="{{byMeal}}" wx:key="meal">
      <view class="row-between">
        <view>
          <view style="font-weight:600;">{{item.meal}}</view>
          <view class="muted" style="font-size:24rpx;">{{item.count}} 条记录</view>
        </view>
        <view style="text-align:right;font-size:24rpx;">
          <view>{{item.calories}} kcal</view>
          <view class="muted">P {{item.protein}} · C {{item.carbs}} · F {{item.fat}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
