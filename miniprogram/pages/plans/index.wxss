.segment {
  display: flex;
  flex-direction: row;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  color: var(--color-muted);
  font-size: 26rpx;
}

.seg.on {
  background: var(--color-ink);
  color: #fffaf3;
  font-weight: 600;
}
